# Copy to .env; Acton loads it automatically.
#
# Toncenter API keys (https://t.me/toncenter). Without a key, Toncenter limits requests to 1 RPS.
# TONCENTER_MAINNET_API_KEY=""
# TONCENTER_TESTNET_API_KEY=""
#
# Script inputs. A value prefills its prompt. An empty value keeps the script default.
# An incorrect value stops the script before it sends anything.
# Set the network only with `--net testnet|mainnet` (optionally with `--tonconnect`).
# The scripts print what they send as AGENTIC_* lines. You can paste these lines back here.

# Signers: Acton wallet names (`acton wallet new --name <name> --local`).
# The scripts offer the named wallet before the Acton wallet picker. Do not put wallet keys here.
# AGENTIC_ADMIN_SIGNER=""            # collection admin
# AGENTIC_REQUESTER_SIGNER=""        # public deploy sender and new wallet owner
# AGENTIC_OWNER_SIGNER=""            # wallet owner
# AGENTIC_FUNDER_SIGNER=""           # pays for internal signed requests

# Delegate key (Ed25519). Create it one time. To replace it, first delete the old line
# and the AGENTIC_DELEGATE_PUBLIC_KEY line.
#   printf '\nAGENTIC_DELEGATE_PRIVATE_KEY=0x%s\n' "$(openssl rand -hex 32)" >> .env
# AGENTIC_DELEGATE_PRIVATE_KEY=""    # SECRET: 32-byte seed; the scripts get the public key from it
# AGENTIC_DELEGATE_PUBLIC_KEY=""     # override only: it replaces the public key of the seed. 0: no delegate

# Addresses
# AGENTIC_COLLECTION=""              # collection
# AGENTIC_WALLET=""                  # agentic wallet
# AGENTIC_WALLET_OWNER=""            # owner of an admin-deployed wallet
# AGENTIC_REFERRAL_ADDRESS=""        # public deploy referral reward recipient
# AGENTIC_NEW_ADMIN=""               # new collection admin
# AGENTIC_NEW_OWNER=""               # new wallet owner
# AGENTIC_EXCESSES_TO=""             # owner change excess recipient
# AGENTIC_RECIPIENT=""               # transfer recipient
# AGENTIC_ROYALTY_ADDRESS=""         # royalty recipient

# Wallet
# AGENTIC_WALLET_INDEX=""            # admin deploy: empty = next, earlier = retry; content edit: wallet to edit
# AGENTIC_WALLET_CONTENT_MODE=""     # index/trait-set/url; empty = current mode on edit, else index
# AGENTIC_WALLET_TRAIT_SET=""        # trait-set mode: trait set index, without .json
# AGENTIC_WALLET_URL=""              # url mode only (other modes ignore it): full wallet content URL
# AGENTIC_COMMENT=""                 # transfer comment
# AGENTIC_FORWARD_COMMENT=""         # ownership_assigned comment

# Amounts in GRAM
# AGENTIC_MESSAGE_VALUE=""           # value sent to the contract
# AGENTIC_DEPLOY_VALUE=""            # collection deploy value
# AGENTIC_WALLET_ATTACH_AMOUNT=""    # admin deploy: value sent to the wallet
# AGENTIC_WALLET_LEFTOVER=""         # public deploy: value in addition to the price, for the wallet
# AGENTIC_FORWARD_AMOUNT=""          # ownership_assigned amount
# AGENTIC_TRANSFER_AMOUNT=""         # transfer amount

# Collection
# AGENTIC_COLLECTION_NAME=""         # collection name
# AGENTIC_COLLECTION_DESCRIPTION=""  # collection description
# AGENTIC_COLLECTION_IMAGE=""        # image URL
# AGENTIC_COLLECTION_COVER_IMAGE=""  # optional cover image URL; "-" = none
# AGENTIC_COLLECTION_EXTERNAL_LINK="" # optional website URL; "-" = none
# AGENTIC_COLLECTION_SOCIAL_LINKS='' # optional JSON array text, for example '["https://a"]'; "-" = none
# AGENTIC_COMMON_CONTENT=""          # wallet content URL prefix, ends with "/"
# AGENTIC_ROYALTY_NUMERATOR=""       # at most the denominator
# AGENTIC_ROYALTY_DENOMINATOR=""     # positive
# AGENTIC_MAX_WALLET_INDEX=""        # highest new wallet index
# AGENTIC_PUBLIC_DEPLOY_ENABLED=""   # true/false
# AGENTIC_DEPLOY_PRICE=""            # public deploy price in GRAM; the scripts require a minimum after the referral share
# AGENTIC_REFERRAL_BPS=""            # referral share of the price, 0..10000 bps
# AGENTIC_TRAIT_SET_COUNT=""         # number of trait sets a public deploy draws from, 1..65535

# Behavior
# AGENTIC_REPLACE_METADATA=""        # collection-edit-content: true/false
# AGENTIC_REPLACE_ROYALTY=""         # collection-edit-content: true/false
# AGENTIC_SIGNED_VIA=""              # external/internal; --tonconnect: internal only
# AGENTIC_CONFIRM_SEND=""            # true/false: default answer before a --net send
